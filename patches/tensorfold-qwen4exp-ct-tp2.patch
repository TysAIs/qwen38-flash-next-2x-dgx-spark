+    if part.untyped_storage().data_ptr() == out.untyped_storage().data_ptr():
+        raise ValueError("FP32 reduction partials and output must not share storage")
+    if _F32_REDUCTION_MODE == "triton":
+        total = m * n
+        _ordered_reduce_f32[(triton.cdiv(total, 1024),)](
+            part, out, total, SK=sk, BLOCK=1024, num_warps=4, enable_fp_fusion=False)
+        return out
+    out.copy_(part[0])
+    for s in range(1, part.shape[0]):
+        out += part[s]
+    return out
+
 
