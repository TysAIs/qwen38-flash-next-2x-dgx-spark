@@ -0,0 +1,26 @@
+"""Explicit per-face Channel8 launch scheduling; no Torch/Triton dependency."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Channel8LaunchConfig:
+    """Keep one config across row counts. Non-default launches require GPU validation."""
+
+    bm: int = 16
+    bn: int = 64
+    bk: int = 64
+    num_warps: int = 4
+    num_stages: int = 3
+
+    def __post_init__(self) -> None:
+        allowed = {
+            "bm": (16,), "bn": (32, 64, 128), "bk": (64,),
+            "num_warps": (2, 4, 8), "num_stages": (1, 2, 3, 4, 5),
+        }
+        for name, values in allowed.items():
+            value = getattr(self, name)
+            if type(value) is not int:
+                raise TypeError(f"{name} must be an integer (not bool or coerced text)")
+            if value not in values:
+                raise ValueError(f"{name} must be one of {values}; got {value}")
diff --git a/src/tensorfold/families/qwen4_exp/cuda/ct_contract.py b/src/tensorfold/families/qwen4_exp/cuda/ct_contract.py
new file mode 100644
index 0000000..67c11be
--- /dev/null
+++ b/src/tensorfold/families/qwen4_exp/cuda/ct_contract.py
@@ -0,0 +1,245 @@
+# SPDX-License-Identifier: MIT
+"""Strict compressed-tensors to TensorFold contracts; no engine admission patch."""
+import math
+
+class ContractError(ValueError):
+    """Unsupported or unverified checkpoint contract."""
+
+def select_nvfp4_groups(config):
+    q = config.get('quantization_config', {})
+    if q.get('quant_method') != 'compressed-tensors' or q.get('format') != 'mixed-precision':
+        raise ContractError('expected CT mixed-precision config')
+    selected = []
+    for name, group in q.get('config_groups', {}).items():
+        w = group.get('weights') or {}
+        if group.get('format') != 'nvfp4-pack-quantized':
+            continue
+        required = {'num_bits': 4, 'type': 'float', 'strategy': 'tensor_group',
+                    'group_size': 16, 'symmetric': True, 'dynamic': False,
+                    'scale_dtype': 'torch.float8_e4m3fn'}
+        if any(type(w.get(k)) is not type(v) or w.get(k) != v for k,v in required.items()):
+            raise ContractError('unsupported NVFP4 scheme: '+name)
+        if any(w.get(k) is not None for k in ('actorder', 'block_structure', 'zp_dtype')):
+            raise ContractError('unsupported NVFP4 ordering/zero point')
+        if not group.get('targets') or any(group.get(k) is not None for k in ('input_activations','output_activations')):
+            raise ContractError('weight-only NVFP4 targets required')
+        selected.append(name)
+    if not selected:
+        raise ContractError('no NVFP4 group')
+    return {'group_size': 16, 'groups': sorted(selected)}
+
+from dataclasses import dataclass
+
+PACKING = 'low-nibble-first-row-major'
+
+@dataclass(frozen=True)
+class VerifiedScale:
+    value: float
+    semantics: str
+    evidence: str
+
+    def __post_init__(self):
+        if isinstance(self.value, bool) or not isinstance(self.value, (int,float)) or not math.isfinite(self.value) or self.value <= 0:
+            raise ContractError('scale must be finite and positive')
+        if self.semantics not in ('ct_reciprocal_global','ple_effective_multiply') or not isinstance(self.evidence,str) or not self.evidence.strip():
+            raise ContractError('producer-confirmed scale semantics/evidence required')
+        if self.semantics == 'ct_reciprocal_global' and not math.isfinite(1.0/self.value):
+            raise ContractError('global reciprocal overflows')
+
+    @property
+    def effective(self):
+        return 1.0/self.value if self.semantics == 'ct_reciprocal_global' else self.value
+
+def _header(header, dtype, shape):
+    if not isinstance(header,dict) or header.get('dtype') != dtype or header.get('shape') != list(shape):
+        raise ContractError('expected '+dtype+' '+str(list(shape)))
+    if not isinstance(header.get('shape'),list) or any(type(x) is not int for x in header['shape']):
+        raise ContractError('header dimensions must be integers, not bool/coerced values')
+    if any(type(x) is not int or x <= 0 for x in shape):
+        raise ContractError('positive integer dimensions required')
+    if 'data_offsets' in header:
+        offsets=header['data_offsets']
+        size=math.prod(shape)*{'U8':1,'F8_E4M3':1,'F32':4}[dtype]
+        if not isinstance(offsets,list) or len(offsets)!=2 or any(type(x) is not int for x in offsets) or offsets[0]<0 or offsets[1]-offsets[0]!=size:
+            raise ContractError('tensor byte span disagrees with dtype/shape')
+
+def expert_contract(prefix, headers, logical_shape, *, packing, global_scale):
+    """Per projection; key map is TF destination -> immutable CT source."""
+    if packing != PACKING or len(logical_shape)!=2:
+        raise ContractError('unsupported packing/layout')
+    n,k=logical_shape
+    if any(type(x) is not int or x<=0 for x in (n,k)) or k%16:
+        raise ContractError('NVFP4 requires [out,in] with group16 inputs')
+    if set(headers)!= {'weight_packed','weight_scale','weight_global_scale'}:
+        raise ContractError('exact CT NVFP4 triple required')
+    _header(headers['weight_packed'],'U8',(n,k//2))
+    _header(headers['weight_scale'],'F8_E4M3',(n,k//16))
+    g=headers['weight_global_scale']
+    if g.get('shape') not in ([],[1],[1,1]):
+        raise ContractError('scalar CT global required')
+    _header(g,'F32',g['shape'])
+    if not isinstance(global_scale,VerifiedScale) or global_scale.semantics!='ct_reciprocal_global':
+        raise ContractError('confirmed CT reciprocal global required, not a PLE global')
+    return {'key_map': {prefix+'.weight':prefix+'.weight_packed',
+                        prefix+'.weight_scale':prefix+'.weight_scale',
+                        prefix+'.weight_scale_2':prefix+'.weight_global_scale'},
+            'global_operation':'reciprocal_F32', 'global_effective':global_scale.effective,
+            'scale_evidence':global_scale.evidence,'logical_shape':list(logical_shape),
+            'packing':packing,'preserve_verbatim':['weight_packed','weight_scale'],
+            'requantization':False}
+
+import struct
+
+MAX_ELEMENTS = 65536
+E2M1 = (0.0,0.5,1.0,1.5,2.0,3.0,4.0,6.0,-0.0,-0.5,-1.0,-1.5,-2.0,-3.0,-4.0,-6.0)
+
+def _f32(value):
+    try:
+        result=struct.unpack('<f',struct.pack('<f',value))[0]
+    except (OverflowError,struct.error) as exc:
+        raise ContractError('FP32 overflow') from exc
+    if not math.isfinite(result):
+        raise ContractError('nonfinite decoded value')
+    return result
+
+def bf16_bits(value):
+    """FP32 -> BF16 round-nearest-even, returning storage bits, not Python BF16."""
+    bits=struct.unpack('<I',struct.pack('<f',_f32(value)))[0]
+    rounded=((bits+0x7fff+((bits>>16)&1))>>16)&0xffff
+    if rounded&0x7f80==0x7f80:
+        raise ContractError('BF16 overflow')
+    return rounded
+
+def e4m3(byte):
+    if type(byte) is not int or not 0<=byte<=255 or byte&0x7f==0x7f:
+        raise ContractError('invalid/nonfinite E4M3FN code')
+    exp,man=(byte>>3)&15,byte&7
+    value=math.ldexp(man/8,-6) if exp==0 else math.ldexp(1+man/8,exp-7)
+    return -value if byte&128 else value
+
+def _bound(rows,columns,output):
+    if type(columns) is not int or columns<=0 or not rows or len(rows)*columns>MAX_ELEMENTS:
+        raise ContractError('selected-row decoding requires 1..65536 elements')
+    if output not in ('fp32','bf16_bits'):
+        raise ContractError('unknown decode output')
+    return bf16_bits if output=='bf16_bits' else _f32
+
+def decode_fp4_rows(packed_rows, block_rows, columns, *, global_scale, packing, output='fp32'):
+    """Bounded selected rows for experts/head/PLE, not full-table materialization."""
+    convert=_bound(packed_rows,columns,output)
+    if packing!=PACKING or columns%16 or len(packed_rows)!=len(block_rows) or not isinstance(global_scale,VerifiedScale):
+        raise ContractError('unknown FP4 layout or unverified global')
+    g=_f32(global_scale.effective)
+    if g<=0:
+        raise ContractError('effective global underflows FP32')
+    result=[]
+    for codes,scales in zip(packed_rows,block_rows):
+        if not isinstance(codes,(bytes,bytearray,memoryview)) or not isinstance(scales,(bytes,bytearray,memoryview)) or len(codes)!=columns//2 or len(scales)!=columns//16:
+            raise ContractError('selected packed/block row shape mismatch')
+        blocks=[e4m3(x) for x in scales]
+        if any(x<0 for x in blocks):
+            raise ContractError('negative NVFP4 block scale')
+        row=[]
+        for col in range(columns):
+            byte=codes[col//2]
+            nib=byte&15 if col%2==0 else byte>>4
+            block=blocks[col//16]
+            # Pinned TF row_scales and retained PLE producer both fold the
+            # effective global into FP32 block scales before E2M1 codes.
+            # The effective global above remains CT reciprocal or PLE direct.
+            decoded=_f32(E2M1[nib]*_f32(block*g))
+            row.append(convert(decoded))
+        result.append(row)
+    return result
+
+@dataclass(frozen=True)
+class VerifiedChannels:
+    values: tuple
+    shape: tuple
+    axis: int
+    evidence: str
+
+    def __post_init__(self):
+        if type(self.axis) is not int or self.axis!=0 or tuple(self.shape) not in ((len(self.values),),(len(self.values),1)) or not self.values:
+            raise ContractError('only output-channel scales [out] or [out,1] axis0 supported')
+        if not isinstance(self.evidence,str) or not self.evidence.strip():
+            raise ContractError('producer-confirmed channel scale evidence required')
+        if any(isinstance(v,bool) or not isinstance(v,(int,float)) or not math.isfinite(v) or v<0 for v in self.values):
+            raise ContractError('finite nonnegative channel scales required')
+
+def decode_fp8_rows(rows, channels, *, output='fp32'):
+    """E4M3FN x real-valued channel scales, never e8m0/MXFP8 relabeling."""
+    convert=_bound(rows,len(rows[0]) if rows else 0,output)
+    if not isinstance(channels,VerifiedChannels) or len(rows)!=len(channels.values):
+        raise ContractError('verified output-channel scales required')
+    width=len(rows[0])
+    if any(not isinstance(row,(bytes,bytearray,memoryview)) or len(row)!=width for row in rows):
+        raise ContractError('ragged/nonbyte FP8 rows')
+    return [[convert(_f32(e4m3(code)*_f32(scale))) for code in row]
+            for row,scale in zip(rows,channels.values)]
+
+import copy
+import re
+
+def bind_ple(config, index, headers_by_file, base, *, global_scale, packing):
+    """Bind physical header triples directly to NVFP4Table; logical hash config is untouched."""
+    if packing!=PACKING or not isinstance(global_scale,VerifiedScale) or global_scale.semantics!='ple_effective_multiply':
+        raise ContractError('PLE requires a verified custom effective multiplicative global')
+    q=config.get('ple_quantization',{})
+    dims=[q.get(k) for k in ('dim','rows','shard_rows','shards','block')]
+    if any(type(x) is not int or x<=0 for x in dims) or q.get('format','nvfp4')!='nvfp4':
+        raise ContractError('unknown PLE geometry/format')
+    width,rows,shard_rows,count,block=dims
+    if block!=16 or width%16 or rows!=shard_rows*count:
+        raise ContractError('unsupported nonuniform/group16 PLE geometry')
+    expected={base+f'.nvfp4_shard_{i}.'+suffix for i in range(count) for suffix in ('packed','scales')}
+    present={key for key in index if key.startswith(base+'.nvfp4_shard_')}
+    if expected!=present or base+'.nvfp4_global' not in index:
+        raise ContractError('PLE physical key set mismatch')
+    hash_base=base.rsplit('.',1)[0]
+    hashes={hash_base+'.'+k:index.get(hash_base+'.'+k) for k in ('layer_multipliers','ngram_heads_offsets','ngram_heads_vocab_sizes')}
+    if not all(hashes.values()):
+        raise ContractError('logical hash metadata absent')
+    logical=config.get('text_config',{})
+    if type(logical.get('split_ngram_parts')) is not int or logical['split_ngram_parts']<=0:
+        raise ContractError('logical ngram split metadata required')
+    files=[]
+    for i in range(count):
+        key=base+f'.nvfp4_shard_{i}'
+        path=index[key+'.packed']
+        if not isinstance(path,str) or not path.endswith('.safetensors') or path.startswith('/') or any(x in ('.','..') for x in path.split('/')):
+            raise ContractError('unsafe PLE physical shard path')
+        if index[key+'.scales']!=path:
+            raise ContractError('packed/block PLE arrays must share one physical file')
+        h=headers_by_file.get(path,{})
+        weight,scale=h.get(key+'.packed'),h.get(key+'.scales')
+        _header(weight,'U8',(shard_rows,width//2))
+        _header(scale,'F8_E4M3',(shard_rows,width//16))
+        if 'data_offsets' not in weight or 'data_offsets' not in scale:
+            raise ContractError('PLE mmap requires real safetensors header offsets')
+        wa,sa=weight['data_offsets'],scale['data_offsets']
+        if max(wa[0],sa[0])<min(wa[1],sa[1]):
+            raise ContractError('overlapping PLE tensor byte spans')
+        files.append([path,copy.deepcopy(weight),copy.deepcopy(scale)])
+    return {'files':files,'starts':[i*shard_rows for i in range(count+1)],
+            'rows':rows,'width':width,'physical_shards':count,
+            'global_effective':global_scale.effective,'scale_evidence':global_scale.evidence,
+            'source_global_key':base+'.nvfp4_global','hash_metadata':hashes,
+            'logical_config':copy.deepcopy(logical),'packing':packing,
+            'placement':'caller_managed_placement_independent','requantization':False}
+
+def expert_aliases(source, prefix, headers, logical_shape, *, packing, global_scale, scale_factory):
+    """No tensor library: aliases preserve source objects; caller supplies scalar tensor factory."""
+    plan=expert_contract(prefix,headers,logical_shape,packing=packing,global_scale=global_scale)
+    if not callable(scale_factory) or any(key not in source for key in plan['key_map'].values()):
+        raise ContractError('complete source triple and scalar factory required')
+    raw_global=source[prefix+'.weight_global_scale']
+    if isinstance(raw_global,(int,float)) and raw_global!=global_scale.value:
+        raise ContractError('verified global disagrees with source scalar')
+    return {prefix+'.weight':source[prefix+'.weight_packed'],
+            prefix+'.weight_scale':source[prefix+'.weight_scale'],
+            prefix+'.weight_scale_2':scale_factory(_f32(plan['global_effective']))}
+
+
+
+
