+# SPDX-License-Identifier: MIT
+"""Read-only actual config/index dry run; no tensor headers or scale values inferred."""
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+from .ct_contract import ContractError, select_nvfp4_groups
+
+TF_PIN='9cd52ab4daba68ddd09be89be8f23ad43175e821'
+CT_PIN='ac8e2ba82f4e0d5eaa40069f8fc642738f124cd4'
+
+
+def _target(target,name):
+    if target.startswith('re:'):
+        return re.match(target[3:],name) is not None
+    return target==name
+
+
+def build_plan(config,index):
+    selection=select_nvfp4_groups(config)
+    groups=config['quantization_config']['config_groups']
+    weight_map=index.get('weight_map')
+    if not isinstance(weight_map,dict) or not weight_map:
+        raise ContractError('safetensors index weight_map required')
+    for key,path in weight_map.items():
+        if not isinstance(key,str) or not isinstance(path,str) or not path.endswith('.safetensors') or Path(path).is_absolute() or any(p in ('.','..') for p in path.split('/')):
+            raise ContractError('invalid tensor identifier or relative shard path')
+    files=sorted(set(weight_map.values()))
+    file_ids={name:i for i,name in enumerate(files)}
+    consumed=set()
+    experts=[]
+    head=None
+    for key in sorted(k for k in weight_map if k.endswith('.weight_packed')):
+        prefix=key[:-len('.weight_packed')]
+        matches=[name for name in selection['groups'] if any(_target(t,prefix) for t in groups[name]['targets'])]
+        if len(matches)!=1:
+            raise ContractError('NVFP4 target missing/ambiguous: '+prefix)
+        names=[prefix+'.'+s for s in ('weight_packed','weight_scale','weight_global_scale')]
+        if any(k not in weight_map for k in names) or prefix+'.weight' in weight_map:
+            raise ContractError('incomplete/colliding CT triple: '+prefix)
+        consumed.update(names)
+        record=[prefix]+[file_ids[weight_map[k]] for k in names]
+        if prefix=='lm_head':
+            text=config.get('text_config',{})
+            n,k=text.get('vocab_size'),text.get('hidden_size')
+            if any(type(x) is not int or x<=0 for x in (n,k)) or k%16:
+                raise ContractError('unsupported CT head shape in config')
+            head={'source':record,'output_key':'lm_head.weight','output_dtype':'BF16',
+                  'logical_shape':[n,k],'bf16_bytes':n*k*2,
+                  'operation':'bounded_CT_NVFP4_decode_FP32_then_BF16_once',
+                  'global_semantics':'producer_confirmed_ct_reciprocal_global',
+                  'format_change':True,'bridge_role':'explicit_diagnostic_or_interface_choice_not_production_default',
+                  'requires':['actual_headers','producer_head_scale_evidence']}
+        elif re.fullmatch(r'.+\.mlp\.experts\.[0-9]+\.(gate|up|down)_proj',prefix):
+            experts.append(record)
+        else:
+            raise ContractError('unknown packed projection layout: '+prefix)
+    if not experts or head is None:
+        raise ContractError('routed experts and exact CT lm_head are required')
+    dense=[]
+    for group_name,group in groups.items():
+        if group_name in selection['groups']:
+            continue
+        w=group.get('weights') or {}
+        expected={'num_bits':8,'type':'float','strategy':'channel','group_size':None,
+                  'symmetric':True,'dynamic':False}
+        if group.get('format')!='naive-quantized' or any(type(w.get(k)) is not type(v) or w.get(k)!=v for k,v in expected.items()):
+            raise ContractError('unknown non-NVFP4 group: '+group_name)
+        if any(group.get(k) is not None for k in ('input_activations','output_activations')) or any(w.get(k) is not None for k in ('block_structure','actorder','zp_dtype')):
+            raise ContractError('unsupported FP8 channel layout')
+        for prefix in group.get('targets',[]):
+            if prefix.startswith('re:'):
+                raise ContractError('this bridge requires explicit FP8 targets')
+            names=[prefix+'.weight',prefix+'.weight_scale']
+            if any(k not in weight_map for k in names) or any(k in consumed for k in names):
+                raise ContractError('incomplete/overlapping FP8 channel projection: '+prefix)
+            consumed.update(names)
+            dense.append([prefix]+[file_ids[weight_map[k]] for k in names])
+    quant_keys={k for k in weight_map if k.endswith(('.weight_packed','.weight_scale','.weight_global_scale'))}
+    if quant_keys-consumed:
+        raise ContractError('unclassified quantized keys: '+str(sorted(quant_keys-consumed)[:3]))
+    global_keys=[k for k in weight_map if k.endswith('.nvfp4_global')]
+    if len(global_keys)!=1:
+        raise ContractError('exactly one custom PLE table required')
+    base=global_keys[0][:-len('.nvfp4_global')]
+    q=config.get('ple_quantization',{})
+    width,rows,shard_rows,count,block=[q.get(k) for k in ('dim','rows','shard_rows','shards','block')]
+    if q.get('format')!='nvfp4' or any(type(x) is not int or x<=0 for x in (width,rows,shard_rows,count,block)) or block!=16 or width%16 or rows!=shard_rows*count:
+        raise ContractError('unsupported PLE declared physical geometry')
+    pairs=[]
+    for i in range(count):
+        keys=[base+f'.nvfp4_shard_{i}.'+s for s in ('packed','scales')]
+        if any(k not in weight_map for k in keys) or weight_map[keys[0]]!=weight_map[keys[1]]:
+            raise ContractError('missing/split PLE physical pair')
+        pairs.append({'packed_key':keys[0],'scale_key':keys[1],'file_id':file_ids[weight_map[keys[0]]],
+                      'expected_packed_shape':[shard_rows,width//2],
+                      'expected_scale_shape':[shard_rows,width//16]})
