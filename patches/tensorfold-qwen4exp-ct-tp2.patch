diff --git a/src/tensorfold/families/qwen4_exp/cuda/ct_ple.py b/src/tensorfold/families/qwen4_exp/cuda/ct_ple.py
new file mode 100644
index 0000000..a524cf6
--- /dev/null
+++ b/src/tensorfold/families/qwen4_exp/cuda/ct_ple.py
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: MIT
+"""Original custom NVFP4 PLE, disjoint GPU row halves, BF16 only at lookup.
+
+Physical storage shards are NOT logical NGram partitions. Every tensor read is
+an original contiguous row interval. No table re-quantization or host lookup.
+Producer arithmetic is FP32(block * direct global), then E2M1, BF16 last.
+"""
+from __future__ import annotations
+from dataclasses import dataclass
+import numpy as np
+import torch
+import triton
+import triton.language as tl
+from .nvfp4 import _e2m1_pattern, _bf16_widen, _e4m3_value
+
+@triton.jit
+def _rows(IDS, P, S, G, OUT, M: tl.constexpr, D: tl.constexpr, LO: tl.constexpr,
+          HI: tl.constexpr, B: tl.constexpr):
+    r=tl.program_id(0)
+    c=tl.arange(0,B)
+    gid=tl.load(IDS+r).to(tl.int64)
+    owned=(gid>=LO)&(gid<HI)
+    local=tl.where(owned,gid-LO,0)
+    packed=tl.load(P+local*(D//2)+c//2,mask=owned&(c<D),other=0).to(tl.int32)
+    code=tl.where(c%2==0,packed&15,packed>>4)
+    block=tl.load(S+local*(D//16)+c//16,mask=owned&(c<D),other=0).to(tl.int32)
+    g=tl.load(G).to(tl.float32)
+    folded=_e4m3_value(block)*g
+    value=_bf16_widen(_e2m1_pattern(code))*folded
+    # Only this shard's owned row is written. OUT was zeroed before launches.
+    tl.store(OUT+r*D+c,value.to(tl.bfloat16),mask=owned&(c<D))
+
+@dataclass
+class GPUHalfPLE:
+    packed: tuple
+    scales: tuple
+    intervals: tuple
+    global_scale: torch.Tensor
+    rows: int
+    width: int
+    rank: int
+    world: int
+    comm: object = None
+    bits: int = 16  # lookup output interface, NOT resident table precision
+    placement: str = 'original_nvfp4_balanced_gpu_half'
+
+    @property
+    def nbytes(self):
+        return sum(t.untyped_storage().nbytes() for t in self.packed+self.scales)+self.global_scale.untyped_storage().nbytes()
+
+    @classmethod
+    def load(cls,reader,plan,ngram,rank,world):
+        from .ct_contract import bind_ple, VerifiedScale, PACKING
+        if world!=2 or rank not in (0,1):raise ValueError('production custom PLE port requires two balanced GPU halves')
+        ple=plan['ple'];base=ple['base'];g=reader.get(ple['source_global_key']).float().reshape(())
+        proof=VerifiedScale(float(g.cpu()),'ple_effective_multiply','retained incumbent ngram_embedding _dequant_nvfp4_rows: block*global then code')
+        headers={f:reader._header(f)[1] for f in {reader.where[p['packed_key']] for p in ple['pairs']}}
+        binding=bind_ple(reader.raw_config,reader.where,headers,base,global_scale=proof,packing=PACKING)
+        if binding['rows']!=ngram.rows or binding['width']!=ngram.dims:raise ValueError('physical PLE geometry differs from actual logical NGram')
+        row0=rank*ngram.rows//world;row1=(rank+1)*ngram.rows//world
+        packed=[];scales=[];intervals=[];at=0
+        for part in ple['pairs']:
+            count=part['expected_packed_shape'][0];lo=max(row0,at);hi=min(row1,at+count)
+            if lo<hi:
+                packed.append(reader.read_rows(part['packed_key'],lo-at,hi-at))
+                scales.append(reader.read_rows(part['scale_key'],lo-at,hi-at).view(torch.uint8))
+                intervals.append((lo,hi))
+            at+=count
+        if sum(hi-lo for lo,hi in intervals)!=row1-row0:raise ValueError('incomplete physical row intersection')
+        return cls(tuple(packed),tuple(scales),tuple(intervals),g,ngram.rows,ngram.dims,rank,world)
+
+    def local_rows(self,ids,out=None):
+        if ids.dtype!=torch.int64 or ids.ndim!=1 or not ids.is_contiguous():raise ValueError('PLE ids must be contiguous CUDA int64')
+        out=torch.empty((ids.numel(),self.width),device=ids.device,dtype=torch.bfloat16) if out is None else out
+        if out.dtype!=torch.bfloat16 or tuple(out.shape)!=(ids.numel(),self.width) or not out.is_contiguous():raise ValueError('invalid PLE lookup output')
+        out.zero_()
+        for p,s,(lo,hi) in zip(self.packed,self.scales,self.intervals):
+            _rows[(ids.numel(),)](ids,p,s,self.global_scale,out,M=ids.numel(),D=self.width,LO=lo,HI=hi,B=triton.next_power_of_2(self.width),num_warps=4)
+        return out
+
+    def stage(self,ids,out):
+        a=np.asarray(ids,dtype=np.int64).reshape(-1)
+        if a.size and (a.min()<0 or a.max()>=self.rows):raise ValueError('PLE row outside original table')
+        ids_gpu=torch.from_numpy(np.ascontiguousarray(a)).to(out.device)
+        partial=self.local_rows(ids_gpu)
+        if self.comm is None:
+            if self.world!=1:raise RuntimeError('two-rank GPU PLE is not bound to its NCCL communicator')
+            out.copy_(partial);return out
+        both=torch.empty((self.world,*partial.shape),dtype=torch.bfloat16,device=out.device)
+        self.comm.all_gather(partial,both)
+        # Select the unique owner's row, not add BF16 values: preserve negative-zero bits too.
+        out.copy_(torch.where((ids_gpu>=self.rows//2)[:,None],both[1],both[0]))
+        return out
+
+    def prefetch(self):return 0.0  # already resident, no host table or thread pool
+    def lock(self):return False
