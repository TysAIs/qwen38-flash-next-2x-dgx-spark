+++ b/tests/test_tp2_concurrency_static.py
@@ -0,0 +1,136 @@
+"""Static guards for the unexercised native TP2 concurrency path. No CUDA, no NCCL, no engine.
+
+Native TP2 concurrency has never run on a GPU, so the defects that live in that
+path are invisible to the suite that exercises a real device. These tests read the
+source and the pure geometry functions, and they assert the two invariants the
+runtime needs before any request is admitted. They are cheap, and they fail loudly
+if a refactor drops either guard.
+"""
+from __future__ import annotations
+
+import ast
+import inspect
+import unittest
+from pathlib import Path
+
+from tensorfold.cuda import geometry as G
+from tensorfold.families.qwen4_exp.cuda import engine as engine_mod
+
+
+def _init_ast() -> ast.FunctionDef:
+    src = inspect.getsource(engine_mod)
+    tree = ast.parse(src)
+    cls = next(n for n in ast.walk(tree) if isinstance(n, ast.ClassDef))
+    return next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "__init__")
+
+
+def _self_attrs(stmts) -> set[str]:
+    out: set[str] = set()
+    for n in ast.walk(ast.Module(body=list(stmts), type_ignores=[])):
+        if isinstance(n, ast.Assign):
+            for t in n.targets:
+                if isinstance(t, ast.Attribute) and isinstance(t.value, ast.Name) and t.value.id == "self":
+                    out.add(t.attr)
+    return out
+
+
+def _concurrent_branches() -> tuple[set[str], set[str]]:
+    fn = _init_ast()
+    conc = next(n for n in ast.walk(fn) if isinstance(n, ast.If)
+                and isinstance(n.test, ast.Attribute) and n.test.attr == "concurrent")
+    return _self_attrs(conc.body), _self_attrs(conc.orelse)
+
+
+class ConcurrentEngineAttributes(unittest.TestCase):
+    """`self.e` is read after the branch for every `streams > 1` start (graph capture, warmup)."""
+
+    def test_concurrent_branch_sets_the_serial_engine_attribute_to_none(self):
+        body, _ = _concurrent_branches()
+        self.assertIn("e", body, "the concurrent branch must set self.e = None; upstream 9cd52ab does")
+
+    def test_serial_branch_is_the_only_one_that_builds_an_engine(self):
+        _, orelse = _concurrent_branches()
+        self.assertIn("e", orelse)
+
+
+class StartupOrderIsCorrect(unittest.TestCase):
+    """engine.py must warm both ranks command-free BEFORE rank 0 enters the lockstep.
+
+    Activating earlier routes warm()'s own admit()/round() through the ordered command
+    path, so rank 0 blocks in prepare() on a rank 1 that has not reached follow() yet.
+    tests/test_tp2_startup_order.py reproduces that hang; this keeps the source honest.
+    """
+
+    def test_rank0_activates_after_every_warm_call(self):
+        src = inspect.getsource(engine_mod)
+        fn = _init_ast()
+        calls = []
+        for n in sorted([n for n in ast.walk(fn) if isinstance(n, ast.Call)], key=lambda x: x.lineno):
+            f = n.func
+            name = f.attr if isinstance(f, ast.Attribute) else getattr(f, "id", "")
+            if name in ("activate", "warm"):
+                calls.append((n.lineno, name))
+        self.assertTrue(calls, "no warm/activate calls found")
+        first_warm = next(ln for ln, n in calls if n == "warm")
+        activates = [ln for ln, n in calls if n == "activate"]
+        self.assertTrue(activates, "rank 0 never activates the lockstep")
+        self.assertTrue(all(ln > first_warm for ln in activates),
+                        f"activate() must follow the first warm() at line {first_warm}, saw {activates}")
+
+    def test_the_activate_call_is_guarded_to_rank_zero_and_tp2(self):
+        src = inspect.getsource(engine_mod)
+        guard = next(ln.strip() for ln in src.splitlines() if "_TP2 is not None" in ln)
+        self.assertIn("rank == 0", guard)
+
+
+class AdmissionGeometryUsesTheRealWorld(unittest.TestCase):
+    """A TP2 concurrent start must budget the rank, not a whole-GPU TP1 shape."""
+
+    def test_engine_passes_world_into_indexed_stream_geometry(self):
+        src = inspect.getsource(engine_mod)
+        call = next(ln for ln in src.splitlines() if "indexed_stream_geometry(text" in ln)
+        window = " ".join(src.split(call, 1)[1].split(")", 1)[0].split())
+        self.assertIn("world=tp", window, f"the admission call omits the rank's world: {window!r}")
+
+    def test_geometry_rejects_an_impossible_world(self):
+        with self.assertRaises(ValueError):
+            G.indexed_stream_geometry({}, 2, 4, 8, mtp=True, world=3)
+
+
+class GeometryBudgets(unittest.TestCase):
+    """The two TP2 costs a TP1 budget cannot see: sharded vocab extent, and FP32 partials/gathers."""
+
+    def _config(self) -> dict:
+        from tests.test_cuda_capacity import small_config
+
+        import copy
+
+        t = copy.deepcopy(small_config())
+        for k, v in dict(hidden_size=4096, num_attention_heads=32, num_key_value_heads=8, head_dim=128,
+                         vocab_size=151936, moe_intermediate_size=4096, hc_count=4,
+                         linear_conv_kernel_dim=128, indexer_head_dim=128).items():
+            t[k] = v
+        return t
+
+    def test_tp1_and_tp2_budgets_differ(self):
+        t, kw = self._config(), {"mtp": True, "kv_bits": 16}
+        one = G.indexed_stream_geometry(t, 4, 6, 8, **kw).bytes_at(8192)
+        two = G.indexed_stream_geometry(t, 4, 6, 8, world=2, **kw).bytes_at(8192)
+        self.assertNotEqual(one, two, "the world must change the concurrent budget")
+
+    def test_tp2_budget_carries_the_partials_a_tp1_budget_omits(self):
+        t, kw = self._config(), {"mtp": True, "kv_bits": 16}
+        one = G.indexed_stream_geometry(t, 4, 6, 8, **kw).bytes_at(8192)
+        two = G.indexed_stream_geometry(t, 4, 6, 8, world=2, **kw).bytes_at(8192)
+        self.assertLess(two, one, "sharded heads/vocab must not cost more than the TP1 shape")
+
+
+class SourceIntegrity(unittest.TestCase):
+    def test_rank_schedule_and_tp2_multi_are_present(self):
+        pkg = Path(inspect.getfile(G)).resolve().parents[1]          # .../src/tensorfold
+        self.assertTrue((pkg / "cuda" / "rank_schedule.py").is_file())
+        self.assertTrue((pkg / "families" / "qwen4_exp" / "cuda" / "tp2_multi.py").is_file())
+
+
+if __name__ == "__main__":
+    unittest.main()
