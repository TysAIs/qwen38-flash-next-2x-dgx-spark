@@ -0,0 +1,115 @@
+"""Ordered CPU request control for native TP2 rounds; never a second GPU scheduler.
+
+NCCL handles tensor collectives. TCPStore carries request/rank-state controls and
+an exact state acknowledgement after each operation. Request cancellation only
+changes head-side callbacks; the next finish/round command synchronizes it.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from datetime import timedelta
+
+VERSION = 1
+OPS = frozenset({"admit", "round", "finish", "drop", "stop"})
+
+
+def digest(value) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def packet(sequence: int, op: str, body: dict) -> dict:
+    if type(sequence) is not int or sequence < 0 or op not in OPS or not isinstance(body, dict):
+        raise ValueError("invalid TP2 scheduler command")
+    return {"version": VERSION, "sequence": sequence, "op": op, "body": body}
+
+
+def parse(text: str | bytes, sequence: int) -> dict:
+    got = json.loads(text)
+    if not isinstance(got, dict) or set(got) != {"version", "sequence", "op", "body"}:
+        raise ValueError("invalid TP2 scheduler command fields")
+    if got != packet(got["sequence"], got["op"], got["body"]) or got["version"] != VERSION:
+        raise ValueError("invalid TP2 scheduler command version")
+    if got["sequence"] != sequence:
+        raise ValueError("out-of-order TP2 scheduler command")
+    return got
+
+
+def fingerprint(decoder) -> str:
+    """No timings/callback cancellation: token/state/cache identities must match."""
+    live = []
+    for sid, s in sorted(decoder.streams.items()):
+        live.append([sid, s.st.pos, s.st.mtp_len, s.cached, s.count,
+                     digest(s.prompt), digest(s.out), digest(s.committed), digest(s.drafts),
+                     s.rounds, s.drafted, s.accepted, str(s.error) if s.error else None])
+    kept = [[digest(k[0]), k[1].pos] for k in decoder.kept]
+    return digest([decoder.next_id, len(decoder.free), live, kept])
+
+
+class TP2Lockstep:
+    """Bound to the actual communicator. Only rank 0 issues monotonically ordered commands."""
+    def __init__(self, comm, slots: int, timeout_s: int = 900):
+        if comm is None or comm.world != 2 or comm.rank not in (0, 1):
+            raise ValueError("native lockstep requires a genuine two-rank communicator")
+        if type(slots) is not int or not 2 <= slots <= 16:
+            raise ValueError("native TP2 slots must be 2..16")
+        self.comm, self.slots, self.timeout_s = comm, slots, timeout_s
+        self.sequence = 0
+        self.active = False  # warmup is symmetric on both ranks, before the follower loop
+
+    def activate(self) -> None:
+        """Enter the native lockstep after symmetric warmup, on both ranks.
+
+        Warmup runs identically on each rank without commands, so the two processes
+        may activate independently; only after this does rank 0 issue ordered
+        commands that rank 1 follows. Activating twice, or after a command has
+        already been exchanged, is a programming error rather than a silent reset.
+        """
+        if self.active:
+            raise RuntimeError("TP2 lockstep is already active; construct a new communicator pair instead")
+        self.active = True
+
+    def _key(self, suffix: str) -> str:
+        return f"tensorfold/tp2/native/{self.sequence}/{suffix}"
+
+    def issue(self, op: str, body: dict) -> dict:
+        if self.comm.rank != 0 or not self.active:
+            raise RuntimeError("only the active rank-0 scheduler may issue a command")
+        got = packet(self.sequence, op, body)
+        self.comm.store.set(self._key("command"), json.dumps(got))
+        return got
+
+    def receive(self) -> dict:
+        if self.comm.rank != 1 or not self.active:
+            raise RuntimeError("only the active follower may receive commands")
+        key = self._key("command")
+        self.comm.store.wait([key], timedelta(seconds=self.timeout_s))
+        got = parse(self.comm.store.get(key), self.sequence)
+        self.comm.store.delete_key(key)
+        return got
+
+    def prepare(self, error: Exception | None = None) -> None:
+        """Both ranks validate/compile a command before either enters its CUDA collectives."""
+        mine = None if error is None else [type(error).__name__, str(error)]
+        own_key = self._key(f"prepare{self.comm.rank}")
+        peer_key = self._key(f"prepare{1 - self.comm.rank}")
+        self.comm.store.set(own_key, json.dumps(mine))
+        self.comm.store.wait([peer_key], timedelta(seconds=self.timeout_s))
+        other = json.loads(self.comm.store.get(peer_key))
+        self.comm.store.delete_key(peer_key)
+        if mine is not None or other is not None:
+            raise RuntimeError(f"TP2 scheduler preparation failed: {mine or other}")
+
+    def acknowledge(self, decoder, error: Exception | None = None) -> None:
+        mine = {"state": fingerprint(decoder), "error": None if error is None else [type(error).__name__, str(error)]}
+        peer = 1 - self.comm.rank
+        own_key, peer_key = self._key(f"ack{self.comm.rank}"), self._key(f"ack{peer}")
+        self.comm.store.set(own_key, json.dumps(mine))
+        self.comm.store.wait([peer_key], timedelta(seconds=self.timeout_s))
+        other = json.loads(self.comm.store.get(peer_key))
+        self.comm.store.delete_key(peer_key)
+        self.sequence += 1
+        if mine != other:
+            raise RuntimeError(f"TP2 scheduler rank state diverged: {mine} != {other}")
+        if error is not None:
+            raise error
