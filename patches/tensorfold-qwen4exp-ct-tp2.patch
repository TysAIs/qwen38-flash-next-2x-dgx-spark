--- /dev/null
+++ b/tests/test_tp2_native_lockstep.py
@@ -0,0 +1,320 @@
+"""CPU-only contract tests for native TP2 request lockstep. No CUDA, no NCCL, no engine.
+
+These use a fake two-rank communicator backed by a real key/value store with
+block/wait semantics, so ordering, acknowledgement and divergence are exercised
+exactly as the production path uses them.
+"""
+from __future__ import annotations
+
+import threading
+import unittest
+from datetime import timedelta
+
+from tensorfold.cuda.rank_schedule import (OPS, TP2Lockstep, digest, fingerprint, packet, parse)
+
+
+class Store:
+    """Minimal TCPStore stand-in: set/wait/get/delete_key with real blocking waits."""
+
+    def __init__(self) -> None:
+        self.data: dict[str, bytes] = {}
+        self.cv = threading.Condition()
+        self.deleted: list[str] = []
+
+    def set(self, key: str, value) -> None:
+        with self.cv:
+            self.data[key] = value.encode() if isinstance(value, str) else value
+            self.cv.notify_all()
+
+    def wait(self, keys, timeout=None) -> None:
+        deadline_keys = list(keys)
+        with self.cv:
+            if all(k in self.data for k in deadline_keys):
+                return
+            self.cv.wait_for(lambda: all(k in self.data for k in deadline_keys), timeout=timeout.total_seconds()
+                             if isinstance(timeout, timedelta) else timeout)
+
+    def get(self, key: str) -> bytes:
+        with self.cv:
+            if key not in self.data:
+                raise KeyError(key)
+            return self.data[key]
+
+    def delete_key(self, key: str) -> None:
+        with self.cv:
+            self.data.pop(key, None)
+            self.deleted.append(key)
+
+
+class Comm:
+    """Two ranks sharing one store. GPU collectives are never touched here."""
+
+    def __init__(self, rank: int, world: int = 2, store: Store | None = None) -> None:
+        self.rank, self.world, self.store = rank, world, store or Store()
+
+
+class FakeStream:
+    def __init__(self, sid: int, pos: int = 5) -> None:
+        self.sid = sid
+        self.prompt = [1, 2, 3]
+        self.count = 32
+        self.cached = 0
+        self.out = [4, 5]
+        self.committed = [4]
+        self.drafts: list[int] = []
+        self.done = False
+        self.error = None
+        self.rounds = 1
+        self.drafted = 2
+        self.accepted = 1
+        from types import SimpleNamespace
+        self.st = SimpleNamespace(pos=pos, mtp_len=pos + 2)
+
+
+class FakeDecoder:
+    """The attributes fingerprint() reads. Stream state is compared across ranks."""
+
+    def __init__(self, streams, kept=(), next_id=0, free=2) -> None:
+        self.streams = dict(streams)
+        self.kept = list(kept)
+        self.next_id = next_id
+        self.free = [object()] * free      # the real decoder's free is a list of State slots
+
+
+class PacketTests(unittest.TestCase):
+    def test_roundtrip_preserves_order_and_body(self):
+        for op in sorted(OPS):
+            body = {"sids": [1, 2], "n": 3}
+            text = packet(7, op, body)
+            import json
+            got = parse(json.dumps(text), 7)
+            self.assertEqual(got["op"], op)
+            self.assertEqual(got["body"], body)
+            self.assertEqual(got["sequence"], 7)
+
+    def test_rejects_wrong_sequence(self):
+        import json
+        with self.assertRaises(ValueError):
+            parse(json.dumps(packet(3, "round", {})), 4)
+
+    def test_rejects_unknown_op_and_extra_fields(self):
+        import json
+        with self.assertRaises(ValueError):
+            packet(0, "nonsense", {})
+        with self.assertRaises(ValueError):
+            parse(json.dumps({"version": 1, "sequence": 0, "op": "round", "body": {}, "x": 1}), 0)
+
+    def test_rejects_future_version(self):
+        import json
+        with self.assertRaises(ValueError):
+            parse(json.dumps({"version": 99, "sequence": 0, "op": "round", "body": {}}), 0)
+
+    def test_rejects_negative_sequence_and_non_dict_body(self):
+        with self.assertRaises(ValueError):
+            packet(-1, "round", {})
+        with self.assertRaises(ValueError):
+            packet(0, "round", [])
+
+
+class FingerprintTests(unittest.TestCase):
+    def test_identical_state_gives_identical_digest(self):
+        a = FakeDecoder({1: FakeStream(1), 2: FakeStream(2)})
+        b = FakeDecoder({1: FakeStream(1), 2: FakeStream(2)})
+        self.assertEqual(fingerprint(a), fingerprint(b))
+
+    def test_every_stream_field_is_covered(self):
+        base = FakeDecoder({1: FakeStream(1)})
+        ref = fingerprint(base)
+        for field, value in (("pos", 99), ("mtp_len", 99)):
+            other = FakeDecoder({1: FakeStream(1)})
+            setattr(other.streams[1].st, field, value)
+            self.assertNotEqual(ref, fingerprint(other), f"st.{field} not covered")
+        for field, value in (("count", 999), ("cached", 7),
+                             ("rounds", 42), ("drafted", 43), ("accepted", 44)):
+            other = FakeDecoder({1: FakeStream(1)})
+            setattr(other.streams[1], field, value)
+            self.assertNotEqual(ref, fingerprint(other), f"{field} not covered")
+        for field, value in (("out", [9]), ("committed", [9]), ("drafts", [9]), ("prompt", [9])):
+            other = FakeDecoder({1: FakeStream(1)})
+            setattr(other.streams[1], field, value)
+            self.assertNotEqual(ref, fingerprint(other), f"{field} not covered")
+
+    def test_stream_error_is_covered(self):
+        a = FakeDecoder({1: FakeStream(1)})
+        b = FakeDecoder({1: FakeStream(1)})
+        b.streams[1].error = ValueError("boom")
+        self.assertNotEqual(fingerprint(a), fingerprint(b))
+
+    def test_free_slots_and_next_id_are_covered(self):
+        a = FakeDecoder({1: FakeStream(1)}, free=2, next_id=0)
+        self.assertNotEqual(fingerprint(a), FakeDecoder({1: FakeStream(1)}, free=3, next_id=0))
+        self.assertNotEqual(fingerprint(a), FakeDecoder({1: FakeStream(1)}, free=2, next_id=1))
+
+    def test_stream_insertion_order_does_not_matter(self):
+        a = FakeDecoder({1: FakeStream(1), 2: FakeStream(2)})
+        b = FakeDecoder({2: FakeStream(2), 1: FakeStream(1)})
+        self.assertEqual(fingerprint(a), fingerprint(b))
+
+    def test_kept_snapshots_are_covered(self):
+        a = FakeDecoder({1: FakeStream(1)})
+        self.assertNotEqual(fingerprint(a), FakeDecoder({1: FakeStream(1)}, kept=[([1, 2], 4)]))
+
+
+class LockstepContractTests(unittest.TestCase):
+    def test_requires_real_two_rank_communicator(self):
+        for comm in (None, Comm(0, world=1), Comm(2, world=2)):
+            with self.assertRaises(ValueError):
+                TP2Lockstep(comm, 4)
+
+    def test_slots_bounded_to_campaign_maximum(self):
+        for slots in (1, 0, 17, -2):
+            with self.assertRaises(ValueError):
+                TP2Lockstep(Comm(0), slots)
+        for slots in (2, 8, 16):
+            TP2Lockstep(Comm(0), slots)
+
+    def test_warmup_is_symmetric_before_the_follower_loop(self):
+        """Before activate(), neither rank may issue or receive."""
+        head, worker = TP2Lockstep(Comm(0), 4), TP2Lockstep(Comm(1), 4)
+        with self.assertRaises(RuntimeError):
+            head.issue("round", {})
+        with self.assertRaises(RuntimeError):
+            worker.receive()
+
+    def test_only_rank_zero_issues_and_only_rank_one_receives(self):
+        store = Store()
+        head, worker = TP2Lockstep(Comm(0, store=store), 4), TP2Lockstep(Comm(1, store=store), 4)
+        head.activate(), worker.activate()
+        head.issue("admit", {"prompt": [1]})
+        with self.assertRaises(RuntimeError):
+            worker.issue("admit", {"prompt": [1]})
+        with self.assertRaises(RuntimeError):
+            head.receive()
+        got = worker.receive()
+        self.assertEqual(got["op"], "admit")
+
+    def test_command_key_is_consumed_so_a_round_is_never_replayed(self):
+        store = Store()
+        head, worker = TP2Lockstep(Comm(0, store=store), 4), TP2Lockstep(Comm(1, store=store), 4)
+        head.activate(), worker.activate()
+        head.issue("round", {"done": []})
+        worker.receive()
+        self.assertIn(store.deleted[-1], store.deleted)
+        self.assertEqual([k for k in store.deleted if k.endswith("command")], store.deleted)
+
+    def test_sequence_advances_only_after_matching_acknowledgement(self):
+        store = Store()
+        head, worker = TP2Lockstep(Comm(0, store=store), 4), TP2Lockstep(Comm(1, store=store), 4)
+        head.activate(), worker.activate()
+        decoder = FakeDecoder({1: FakeStream(1)})
+
+        errors = []
+
+        def follower():
+            try:
+                while True:
+                    got = worker.receive()
+                    if got["op"] == "stop":
+                        worker.prepare()
+                        worker.acknowledge(decoder)
+                        return
+                    worker.prepare()
+                    worker.acknowledge(decoder)
+            except Exception as exc:  # noqa: BLE001
+                errors.append(exc)
+
+        thread = threading.Thread(target=follower, daemon=True)
+        thread.start()
+        for op in ("admit", "round", "finish"):
+            head.issue(op, {})
+            head.prepare()
+            head.acknowledge(decoder)
+            self.assertEqual(errors, [])
+        self.assertEqual(head.sequence, 3)
+        head.issue("stop", {})
+        head.prepare()
+        head.acknowledge(decoder)
+        thread.join(timeout=10)
+        self.assertFalse(thread.is_alive())
+        self.assertEqual(errors, [])
+        self.assertEqual(head.sequence, 4)
+
+    def test_divergent_stream_state_is_rejected(self):
+        """The whole point: two ranks that disagree on token state must not proceed."""
+        store = Store()
+        head, worker = TP2Lockstep(Comm(0, store=store), 4), TP2Lockstep(Comm(1, store=store), 4)
+        head.activate(), worker.activate()
+        head_state = FakeDecoder({1: FakeStream(1, pos=5)})
+        worker_state = FakeDecoder({1: FakeStream(1, pos=6)})  # one extra token committed
+        errors = []
+
+        def follower():
+            try:
+                got = worker.receive()
+                worker.prepare()
+                worker.acknowledge(worker_state)
+            except Exception as exc:  # noqa: BLE001
+                errors.append(exc)
+
+        thread = threading.Thread(target=follower, daemon=True)
+        thread.start()
+        head.issue("round", {})
+        head.prepare()
+        with self.assertRaises(RuntimeError) as caught:
+            head.acknowledge(head_state)
+        self.assertIn("diverged", str(caught.exception))
+        thread.join(timeout=10)
+        self.assertTrue(any("diverged" in str(e) for e in errors))
+
+    def test_preparation_failure_stops_both_ranks_before_collectives(self):
+        store = Store()
+        head, worker = TP2Lockstep(Comm(0, store=store), 4), TP2Lockstep(Comm(1, store=store), 4)
+        head.activate(), worker.activate()
+        errors = []
+
+        def follower():
+            try:
+                worker.receive()
+                worker.prepare(ValueError("worker rejected this request"))
+            except Exception as exc:  # noqa: BLE001
+                errors.append(exc)
+
+        thread = threading.Thread(target=follower, daemon=True)
+        thread.start()
+        head.issue("admit", {})
+        with self.assertRaises(RuntimeError) as caught:
+            head.prepare()
+        self.assertIn("preparation failed", str(caught.exception))
+        thread.join(timeout=10)
+        self.assertTrue(any("preparation failed" in str(e) for e in errors))
+
+    def test_error_is_raised_on_the_issuing_rank_after_acknowledgement(self):
+        """A matched request error must surface on both ranks, not be swallowed."""
+        store = Store()
+        head, worker = TP2Lockstep(Comm(0, store=store), 4), TP2Lockstep(Comm(1, store=store), 4)
+        head.activate(), worker.activate()
+        decoder = FakeDecoder({1: FakeStream(1)})
+        errors = []
+
+        def follower():
+            try:
+                got = worker.receive()
+                worker.prepare()
+                worker.acknowledge(decoder, ValueError("same failure both ranks"))
+            except ValueError:
+                pass
+            except Exception as exc:  # noqa: BLE001
+                errors.append(exc)
+
+        thread = threading.Thread(target=follower, daemon=True)
+        thread.start()
+        head.issue("admit", {})
+        head.prepare()
+        with self.assertRaises(ValueError):
+            head.acknowledge(decoder, ValueError("same failure both ranks"))
+        thread.join(timeout=10)
+        self.assertEqual(errors, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
