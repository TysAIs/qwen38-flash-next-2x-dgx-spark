+"""CT CUDA faces retaining original FP8/channel and packed NVFP4 storage.
+
+No activation-FP8 prefill, no re-quantization. FP8 channel values are decoded
+and rounded to BF16 inside the matmul; original codes and scales remain resident.
+NVFP4 uses the existing row-invariant packed-weight kernel, with validated CT
+reciprocal globals. Cross-engine arithmetic/quality still require real tests.
+"""
+from __future__ import annotations
+from dataclasses import dataclass
+import torch
+try:
+    import triton
+    import triton.language as tl
+except ModuleNotFoundError:
+    triton = None
+from . import bf16, nvfp4
+from .channel_launch import Channel8LaunchConfig
+
+if triton is not None:
+    @triton.jit
+    def _channel_mm(X, W, S, Y, P, M: tl.constexpr, N: tl.constexpr, K: tl.constexpr,
+                    XS: tl.constexpr, SK: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr,
+                    BK: tl.constexpr, F32: tl.constexpr):
+        rm = tl.program_id(0)*BM + tl.arange(0,BM)
+        rn = tl.program_id(1)*BN + tl.arange(0,BN)
+        rk = tl.arange(0,BK)
+        ps = tl.program_id(2)
+        acc = tl.zeros((BM,BN),tl.float32)
+        scale = tl.load(S+rn, mask=rn<N, other=0).to(tl.float32)
+        for i in range(K//SK//BK):
+            kk = (ps*(K//SK//BK)+i)*BK+rk
+            x = tl.load(X+rm[:,None]*XS+kk[None,:],mask=rm[:,None]<M,other=0)
+            w = tl.load(W+rn[:,None]*K+kk[None,:],mask=rn[:,None]<N,other=0).to(tl.float8e4nv,bitcast=True).to(tl.float32)
+            w = (w*scale[:,None]).to(tl.bfloat16)
+            acc = tl.dot(x,tl.trans(w),acc)
+        mask=(rm[:,None]<M)&(rn[None,:]<N)
+        if SK == 1:
+            tl.store(Y+rm[:,None]*N+rn[None,:],acc if F32 else acc.to(tl.bfloat16),mask=mask)
+        else:
+            tl.store(P+(ps*M+rm[:,None])*N+rn[None,:],acc,mask=mask)
+
+@dataclass
+class Channel8:
+    weight: torch.Tensor
+    scale: torch.Tensor
+    n: int
+    k: int
+    kernel: str = 'ct_fp8_channel'
+    launch_config: Channel8LaunchConfig = Channel8LaunchConfig()
+
+    def __post_init__(self):
+        if not isinstance(self.launch_config, Channel8LaunchConfig):
+            raise TypeError('Channel8 launch_config must be a Channel8LaunchConfig')
+
+    @classmethod
+    def from_rows(cls, weight, scale, *, launch_config: Channel8LaunchConfig = Channel8LaunchConfig()):
+        if weight.dtype != torch.float8_e4m3fn or weight.ndim != 2:
+            raise ValueError('CT channel face needs e4m3 [out,in]')
+        n,k=weight.shape
+        if tuple(scale.shape)!=(n,1) or scale.dtype not in (torch.bfloat16,torch.float32):
+            raise ValueError('CT channel scale must be BF16/F32 [out,1], not input/block axes')
+        if k%64 or not bool(torch.isfinite(scale.float()).all()) or not bool((scale.float()>0).all()):
+            raise ValueError('invalid CT channel shape/scale')
+        return cls(weight.contiguous(),scale.contiguous(),n,k,launch_config=launch_config)
+
+    def nbytes(self):
+        return self.weight.numel()+self.scale.numel()*self.scale.element_size()
+
+    def __call__(self,x,out=None):
+        if triton is None: raise RuntimeError('Channel8 CUDA needs Triton')
+        if x.dtype!=torch.bfloat16 or x.ndim!=2 or x.shape[1]!=self.k or x.stride(1)!=1:
+            raise ValueError('CT channel input must be contiguous-inner BF16 [rows,in]')
+        m=x.shape[0]; f32=out is not None and out.dtype==torch.float32
+        y=torch.empty((m,self.n),dtype=torch.float32 if f32 else torch.bfloat16,device=x.device)
+        sk=bf16.split_k(self.n,self.k)
+        part=torch.empty((sk,m,self.n),dtype=torch.float32,device=x.device) if sk>1 else y
+        launch=self.launch_config
+        _channel_mm[(triton.cdiv(m,launch.bm),triton.cdiv(self.n,launch.bn),sk)](x,self.weight.view(torch.uint8),self.scale,y,part,
+            M=m,N=self.n,K=self.k,XS=x.stride(0),SK=sk,BM=launch.bm,BN=launch.bn,BK=launch.bk,F32=f32,
+            num_warps=launch.num_warps,num_stages=launch.num_stages)
+        if sk>1:
+            if f32:
+                if bf16._F32_REDUCTION_MODE == "triton":
+                    bf16.reduce_f32(part,y)
+                else:
+                    y.copy_(part[0])
+                    for i in range(1,sk):y.add_(part[i])
+            else:
+                bf16._reduce[(triton.cdiv(m*self.n,1024),)](part,y,m*self.n,SK=sk,BLOCK=1024,num_warps=4)
+        if out is not None:out.copy_(y);return out
+        return y
+
+    def prefill(self,x,out=None):
+        return self(x,out)  # exactly the decode arithmetic; never quantize activations to FP8
+
+@dataclass
+class Native4:
+    fp: nvfp4.FP4
+    n: int
+    k: int
+    kernel: str = 'ct_nvfp4'
+
+    @classmethod
+    def from_rows(cls,packed,scale,effective_global):
+        n,k2=packed.shape
+        if packed.dtype!=torch.uint8 or scale.dtype!=torch.float8_e4m3fn or tuple(scale.shape)!=(n,k2//8):
+            raise ValueError('NVFP4 face requires U8[N,K/2],FP8[N,K/16]')
+        if effective_global.numel()!=1 or not bool(torch.isfinite(effective_global).all()) or not bool((effective_global>0).all()):
+            raise ValueError('invalid NVFP4 effective global')
+        pad=(-n)%64
+        if pad:
+            packed=torch.cat([packed,torch.zeros((pad,k2),dtype=torch.uint8,device=packed.device)])
+            # torch.cat on FP8 may not be implemented on older Torch; concatenate bytes then reinterpret.
+            scale=torch.cat([scale.view(torch.uint8),torch.zeros((pad,k2//8),dtype=torch.uint8,device=scale.device)]).view(torch.float8_e4m3fn)
+        return cls(nvfp4.make_fp4(packed,scale,effective_global),n,k2*2)
+
+    def nbytes(self):return self.fp.nbytes()
+    def __call__(self,x,out=None):
+        y=nvfp4.matmul(x,self.fp,f32=out is not None and out.dtype==torch.float32)[:,:self.n]
+        if out is not None:out.copy_(y);return out
+        return y.contiguous()
+    def prefill(self,x,out=None):return self(x,out)
+
+@dataclass
+class StackedFaces:
+    parts: tuple
+    n: int
+    k: int
+    kernel: str = 'ct_stack'
+
+    @classmethod
+    def make(cls,parts):
+        if not parts or len({p.k for p in parts})!=1:raise ValueError('projection stack input dimensions differ')
+        return parts[0] if len(parts)==1 else cls(tuple(parts),sum(p.n for p in parts),parts[0].k)
+    def nbytes(self):return sum(p.nbytes() for p in self.parts)
+    def __call__(self,x,out=None):
+        f32=out is not None and out.dtype==torch.float32
+        values=[]
+        for p in self.parts:
+            if getattr(p,'kernel','')=='b16':
+                values.append(bf16.matmul(x,p.b,f32=f32))
+            else:
+                v=torch.empty((x.shape[0],p.n),dtype=torch.float32,device=x.device) if f32 else None
+                values.append(p(x,v))
+        y=torch.cat(values,dim=1)
+        if out is not None:out.copy_(y);return out
+        return y
+    def prefill(self,x,out=None):return self(x,out)
