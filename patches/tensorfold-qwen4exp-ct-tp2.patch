@@ -0,0 +1,104 @@
+# SPDX-License-Identifier: MIT
+"""Narrow CT hibrid48 reader: original packed/channel tensors, reciprocal globals.
+
+Config/index are validated before accepting the format. Source keys are never
+changed, and an alias is only a read interface, not a rewritten checkpoint.
+"""
+from __future__ import annotations
+import json
+import math
+from .reader import _Reader, _DT
+from .ct_plan import build_plan
+from .ct_native import Channel8, Native4, StackedFaces
+from .bf16 import b16_from_rows, stack_b16
+import torch
+
+class CTReader(_Reader):
+    def __init__(self,model_dir,device):
+        super().__init__(model_dir,device)
+        self.raw_config=json.loads((model_dir/'config.json').read_text())
+        self.plan=build_plan(self.raw_config,{'weight_map':self.where})
+        self.aliases={}
+        for record in self.plan['expert_records']+[self.plan['head']['source']]:
+            name=record[0]
+            self.aliases[name+'.weight']=name+'.weight_packed'
+            self.aliases[name+'.weight_scale_2']=name+'.weight_global_scale'
+        self._head=None
+
+    def has(self,name):return name in self.where or name in self.aliases
+
+    def get(self,name):
+        source=self.aliases.get(name,name)
+        x=super().get(source)
+        if name.endswith('.weight_scale_2') and source!=name:
+            if x.dtype!=torch.float32 or x.numel()!=1 or not bool(torch.isfinite(x).all()) or not bool((x>0).all()):
+                raise ValueError(f'{source}: original CT global must be positive scalar F32')
+            return torch.reciprocal(x.float())  # per projection, never one global shared by gate/up
+        return x
+
+    def read_rows(self,name,lo,hi):
+        shard=self.where[name];base,header=self._header(shard);entry=header[name]
+        shape=entry['shape'];dtype=_DT[entry['dtype']]
+        if len(shape)!=2 or not 0<=lo<hi<=shape[0]:raise ValueError('invalid original contiguous row interval')
+        rowbytes=shape[1]*torch.empty((),dtype=dtype).element_size()
+        begin,end=entry['data_offsets']
+        if end-begin!=shape[0]*rowbytes:raise ValueError('original row span size differs from header')
+        raw=self.io.read(self.dir/shard,base+begin+lo*rowbytes,(hi-lo)*rowbytes,self.device)
+        self.touched.add(shard)
+        return raw.view(dtype).reshape(hi-lo,shape[1])
+
+    def face(self,*parts):
+        faces=[]
+        for part in parts:
+            name=part[0];rows=part[1] if len(part)>1 else None;cols=part[2] if len(part)>2 else None
+            w=self.get(name+'.weight');fp8=w.dtype==torch.float8_e4m3fn
+            s=self.get(name+'.weight_scale') if fp8 else None
+            if fp8 and (s.dtype not in (torch.bfloat16,torch.float32) or tuple(s.shape)!=(w.shape[0],1)):
+                raise ValueError(f'{name}: original FP8 needs real BF16/F32 [output,1] scales, not MXFP8')
+            if rows is not None:
+                w=w.view(torch.uint8)[rows].view(torch.float8_e4m3fn) if fp8 else w[rows]
+                if s is not None:s=s[rows]
+            if cols is not None:w=w[:,cols]  # input splitting does NOT split/relabel output-channel scale
+            faces.append(Channel8.from_rows(w.contiguous(),s.contiguous()) if fp8 else b16_from_rows(w.contiguous()))
+        if all(getattr(f,"kernel","")=="b16" for f in faces):
+            return faces[0] if len(faces)==1 else stack_b16(faces)
+        return StackedFaces.make(faces)
+
+    def head_face(self,rows):
+        if self._head is None:
+            self._head=(self.get('lm_head.weight'),self.get('lm_head.weight_scale'),self.get('lm_head.weight_scale_2'))
+        p,s,g=self._head
+        if isinstance(rows,torch.Tensor):
+            p=p.index_select(0,rows);s=s.view(torch.uint8).index_select(0,rows).view(torch.float8_e4m3fn)
+        else:p=p[rows];s=s[rows]
+        return Native4.from_rows(p.contiguous(),s.contiguous(),g)
+
+
+def weight_transform(world,mtp):
+    """Conservative actual retained-format TP shares for header-only admission.
+
+PLE physical arrays are GPU resident (not reclaimable mapped pages). Every
+expert's scalar global is replicated; row/column slices preserve packed/scales.
+Draft head is conservatively counted as a second native head, not BF16/Q4.
+"""
+    from tensorfold.cuda.geometry import indexed_weights, size
+    generic=indexed_weights(world,mtp,mapped_tables=False)
+    def transform(name,info):
+        if 'vision' in name or '.visual.' in name or (not mtp and name.startswith('mtp.')):return 0,0
+        amount=size(info,name)
+        if '.nvfp4_shard_' in name:return amount//world,0
+        if name.endswith('.nvfp4_global'):return amount,0
+        if '.experts.' in name:
+            return (amount if name.endswith('.weight_global_scale') else amount//world),0
+        if name.startswith('lm_head.'):
+            # head tiling includes rows rounded to64 and one FP32 global per row.
+            if name.endswith('.weight_global_scale'):
+                # Header of a scalar has no vocabulary dimension; the paired
+                # packed/scale rows above each include a512KiB margin for it.
+                return amount*(2 if mtp else 1),0
+            return (amount//world+512*1024)*(2 if mtp else 1),0
+        # Output channel [N,1] scales on input-split output projections are replicated.
+        if name.endswith('.weight_scale') and any(x in name for x in ('.o_proj.','.out_proj.','.down_proj.')):
+            if info['dtype'] in ('BF16','F32'):return amount,0
+        return generic(name,info)
+    return transform
