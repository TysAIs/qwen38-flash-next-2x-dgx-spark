+    @triton.jit
+    def _ordered_reduce_f32(PART, OUT, total, SK: tl.constexpr, BLOCK: tl.constexpr):
+        """Load slice zero first; a dependent non-FTZ round-nearest FP32 add per slice."""
+        offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+        ok = offs < total
+        acc = tl.load(PART + offs, mask=ok, other=0.0)
+        for s in tl.static_range(1, SK):
+            value = tl.load(PART + s * total + offs, mask=ok, other=0.0)
+            # Opaque dependent add.rn (no .ftz), not an optimizer-reassociated sum.
+            # Actual PTX/SASS and Torch-vs-Triton bits remain GPU acceptance gates.
+            acc = tl.inline_asm_elementwise(
+                "add.rn.f32 $0, $1, $2;", constraints="=f,f,f", args=[acc, value],
+                dtype=tl.float32, is_pure=True, pack=1)
+        tl.store(OUT + offs, acc, mask=ok)
+
+
+_F32_REDUCTION_MODE = "python"
+_F32_REDUCTION_CONFIGURED = False
+
+
+def configure_f32_reduction(mode: str) -> None:
+    """Choose once per rank at process startup, before warmup/any graph capture.
+
+    No CLI/environment hook or per-row mutation. Existing completed graphs cannot
+    be detected here: callers must never configure after creating any graph.
+    Restart both ranks to change mode or roll back.
+    """
+    global _F32_REDUCTION_MODE, _F32_REDUCTION_CONFIGURED
+    if type(mode) is not str:
+        raise TypeError("FP32 reduction mode must be a string")
+    if mode not in ("python", "triton"):
+        raise ValueError("FP32 reduction mode must be 'python' or 'triton'")
+    if _F32_REDUCTION_CONFIGURED:
+        raise RuntimeError("FP32 reduction mode already configured; restart both ranks")
+    if torch.cuda.is_available() and torch.cuda.is_current_stream_capturing():
+        raise RuntimeError("configure FP32 reduction before graph capture")
+    if mode == "triton" and not HAS_TRITON:
+        raise RuntimeError("the ordered FP32 reduction needs Triton")
+    _F32_REDUCTION_MODE = mode
+    _F32_REDUCTION_CONFIGURED = True
+
+
+def reduce_f32(part: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+    """Reduce nonaliasing contiguous CUDA FP32 [SK,M,N] into [M,N], returning out."""
+    if _F32_REDUCTION_MODE not in ("python", "triton"):
+        raise RuntimeError("invalid private FP32 reduction mode; use configure_f32_reduction")
+    if not isinstance(part, torch.Tensor) or not isinstance(out, torch.Tensor):
+        raise TypeError("FP32 reduction requires Tensor partials and output")
+    if (part.ndim != 3 or out.ndim != 2 or part.dtype != torch.float32 or out.dtype != torch.float32
+            or not part.is_contiguous() or not out.is_contiguous()
+            or not part.is_cuda or not out.is_cuda or part.device != out.device):
+        raise ValueError("FP32 reduction requires contiguous FP32 CUDA [SK,M,N] and [M,N] on the same device")
+    sk, m, n = part.shape
+    if sk not in (1, 2, 4, 8, 16, 32) or m <= 0 or n <= 0 or out.shape != (m, n):
