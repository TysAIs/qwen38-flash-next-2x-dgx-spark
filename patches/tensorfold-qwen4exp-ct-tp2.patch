new file mode 100644
index 0000000..9fe9866
--- /dev/null
+++ b/src/tensorfold/families/qwen4_exp/cuda/tp2_multi.py
@@ -0,0 +1,141 @@
+"""Native packed TP2 rounds with a single head scheduler and a mirrored worker.
+
+Experimental until actual checkpoint overlap/exactness/context tests pass. It
+never uses HTTP queuing as evidence of native request overlap. Warmup is symmetric;
+only afterward does rank 0 issue ordered commands to rank 1.
+"""
+from __future__ import annotations
+
+from tensorfold.cuda.rank_schedule import TP2Lockstep
+from tensorfold.cuda.streams import Stream
+from tensorfold.engine.exact_sampling import Sampling
+from tensorfold.engine.grammar import pack
+
+from .multi import MultiDecoder
+
+
+def request_body(s: Stream) -> dict:
+    smp = s.sampling
+    return {"prompt": list(s.prompt), "count": s.count, "draft": s.draft, "stop_eos": s.stop_eos,
+            "background": s.background, "owed": list(s.owed), "carry": s.carry,
+            "sampling": None if smp is None else [smp.seed, smp.temperature, smp.top_k, smp.top_p, smp.min_p],
+            "grammar": pack(s.constraint)}
+
+
+class TP2MultiDecoder(MultiDecoder):
+    def __init__(self, w, *, slots: int, **kwargs):
+        self.control = TP2Lockstep(w.comm, slots)
+        self.owner = None
+        self.native_rounds = 0
+        self.max_native_active = 0
+        self.last_native_active = 0
+        self.last_native_rows = 0
+        self.round_histogram: dict[int, int] = {}
+        super().__init__(w, slots=slots, _rank_control=self.control, **kwargs)
+
+    def activate(self, owner) -> None:
+        self.owner = owner
+        self.control.activate()
+
+    def _leader(self, op: str, body: dict, fn):
+        self.control.issue(op, body)
+        self.control.prepare()
+        result, error = None, None
+        try:
+            result = fn()
+        except Exception as exc:
+            error = exc
+        self.control.acknowledge(self, error)
+        return result
+
+    def admit(self, s: Stream) -> None:
+        if not self.control.active:
+            return super().admit(s)
+        return self._leader("admit", request_body(s), lambda: super(TP2MultiDecoder, self).admit(s))
+
+    def _round(self):
+        live = [s for s in self.streams.values() if not s.done]
+        self.last_native_active = len(live)
+        self.last_native_rows = sum(1 + len(s.drafts) for s in live)
+        self.max_native_active = max(self.max_native_active, len(live))
+        self.native_rounds += bool(live)
+        if live:
+            self.round_histogram[len(live)] = self.round_histogram.get(len(live), 0) + 1
+        return super().round()
+
+    def round(self):
+        if not self.control.active:
+            return self._round()
+        body = {"done": [sid for sid, s in self.streams.items() if s.done]}
+        return self._leader("round", body, self._round)
+
+    def finish(self, done):
+        if not self.control.active:
+            return super().finish(done)
+        return self._leader("finish", {"sids": [s.sid for s in done]},
+                            lambda: super(TP2MultiDecoder, self).finish(done))
+
+    def drop(self):
+        if not self.control.active:
+            return super().drop()
+        return self._leader("drop", {}, lambda: super(TP2MultiDecoder, self).drop())
+
+    def shutdown(self):
+        return self._leader("stop", {}, lambda: None)
+
+    def _stream(self, body):
+        smp = body["sampling"]
+        constraint = None
+        if body["grammar"]:
+            from tensorfold.engine import grammar
+            constraint = grammar.compiler(self.owner, self.owner.model_dir, self.owner.eos).follow(body["grammar"])
+        return Stream(body["prompt"], body["count"], None if smp is None else Sampling(*smp),
+                      draft=body["draft"], stop_eos=body["stop_eos"], background=body["background"],
+                      constraint=constraint, owed=body["owed"], carry=body["carry"])
+
+    def follow(self):
+        while True:
+            got = self.control.receive()
+            op, body = got["op"], got["body"]
+            error, s = None, None
+            try:
+                if op == "admit":
+                    s = self._stream(body)
+                elif op in ("round", "finish"):
+                    for sid in body["done" if op == "round" else "sids"]:
+                        if sid not in self.streams:
+                            raise ValueError(f"unknown TP2 stream {sid}")
+            except Exception as exc:
+                error = exc
+            self.control.prepare(error)
+            error = None
+            try:
+                if op == "admit":
+                    super().admit(s)
+                elif op == "round":
+                    for sid in body["done"]:
+                        self.streams[sid].done = True  # head callback cancellation, before any collective
+                    self._round()
+                elif op == "finish":
+                    super().finish([self.streams[sid] for sid in body["sids"]])
+                elif op == "drop":
+                    super().drop()
+            except Exception as exc:
+                error = exc
+            try:
+                self.control.acknowledge(self, error)
+            except Exception:
+                if error is None:
+                    raise
+                # A matched request/grammar error was acknowledged on both ranks;
+                # the head scheduler will finish/drop it before advancing.
+                print(f"[tensorfold] TP2 native {op} failed on both ranks: {error}", flush=True)
+            if op == "stop":
+                return
+
+    def metrics(self) -> dict:
+        return {"native_requests_active": sum(not s.done for s in self.streams.values()),
+                "native_max_active": self.max_native_active, "native_rounds": self.native_rounds,
+                "native_last_active": self.last_native_active, "native_last_rows": self.last_native_rows,
+                "native_round_histogram": dict(self.round_histogram),
+                "native_rank_sequence": self.control.sequence}
